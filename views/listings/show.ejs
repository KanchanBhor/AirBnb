<% layout("layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="container mt-4 mb-5">
  <div class="row justify-content-center">
    <div class="col-lg-9 col-md-10">
      <img src="<%= listing.image.url %>" class="img-fluid rounded-4 w-100" style="height:400px; object-fit:cover;" alt="listing image">
      <div class="mt-4">
        <p class="text-muted mb-1">Owned by <b><%= listing.owner.username %></b></p>
        <h1 class="fw-semibold mb-2"><%= listing.title %></h1>
        <p class="text-muted mb-4"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></p>
        <% if(listing.reviews.length > 0) { %>
          <p class="mb-4">
            <span class="text-warning">★</span>
            <b><%= averageRating %></b>
            <span class="text-muted">· <%= listing.reviews.length %> reviews</span>
          </p>
        <% } %>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
          <div class="card-body p-4">
            <h5 class="fw-semibold mb-2">About this place</h5>
            <p class="text-muted mb-0"><%= listing.description %></p>
          </div>
        </div>
        <div class="row g-3 mb-4">
          <div class="col-sm-6">
            <div class="border rounded-4 p-3 h-100">
              <small class="text-muted d-block">Price</small>
              <h5 class="mb-0">₹<%= listing.price.toLocaleString("en-IN") %> <small class="text-muted">/ night</small></h5>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="border rounded-4 p-3 h-100">
              <small class="text-muted d-block">Category</small>
              <h5 class="mb-0"><%= listing.category || "Not specified" %></h5>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
              <h4 class="fw-semibold mb-3">Book this Place</h4>

              <form action="/listings/<%= listing._id %>/book" method="POST" id="bookingForm">
                <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label fw-semibold">Check-in</label>
          <input type="date" id="checkIn" name="checkIn" class="form-control" required>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label fw-semibold">Check-out</label>
                      <input type="date" id="checkOut" class="form-control" name="checkOut" required>
                    </div>
            
                    <div class="col-md-6">
                      <label class="form-label fw-semibold">Guests</label>
                      <input type="number" id="guests" name="guests"class="form-control" min="1" value="1" required>
                    </div>
                  </div>
            
                  <div class="mt-4 p-3 bg-light rounded-3">
                    <div class="d-flex justify-content-between">
                      <span>Price per night</span>
                      <b>₹<%= listing.price.toLocaleString("en-IN") %></b>
                    </div>
            
                    <div class="d-flex justify-content-between mt-2">
                      <span>Number of nights</span>
                      <b id="nights">0</b>
                    </div>
            
                    <hr>
                    <span id="pricePerNight" data-price="<%= listing.price %>"></span>
                    <div class="d-flex justify-content-between">
                      <span class="fw-semibold">Total</span>
                      <b id="totalPrice">₹0</b>
                    </div>
                </div>
                <button type="submit" class="btn btn-dark rounded-pill px-4 mt-4 w-100">
                  Book Now
                </button>
              </form>
            </div>
        </div>



        <div class="d-flex flex-wrap gap-2 mb-5">
          <form action="/listings/<%= listing._id %>/wishlist" method="POST" class="d-inline">
            <% if(currUser && currUser.wishlist.some(id => id.equals(listing._id))) { %>
              <button class="btn btn-danger rounded-pill px-4">❤️ Saved</button>
            <% } else { %>
              <button class="btn btn-outline-danger rounded-pill px-4">♡ Save to Wishlist</button>
            <% } %>
          </form>
          <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-4">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
              <button class="btn btn-outline-dark rounded-pill px-4">Delete</button>
            </form>
          <% } %>
        </div>
        <% if(currUser) { %>
          <hr class="mb-4">
          <div class="card border-0 shadow-sm rounded-4 mb-5">
            <div class="card-body p-4">
              <h4 class="fw-semibold mb-3">Leave a Review</h4>
              <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Rating</label>
                  <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" name="review[rating]" class="input-no-rate" value="1" checked aria-label="No rating"/>
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" required>
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2">
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3">
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4">
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5">
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
                </div>
                <div class="mb-3">
                  <label for="comment" class="form-label fw-semibold">Comments</label>
                  <textarea name="review[comment]" id="comment" rows="4" required class="form-control rounded-3" placeholder="Share your experience..."></textarea>
                  <div class="invalid-feedback">Please submit some comments for review.</div>
                </div>
                <button class="btn btn-dark rounded-pill px-4">Submit Review</button>
              </form>
            </div>
          </div>
        <% } %>
        <% if(listing.reviews.length > 0) { %>
          <div class="mb-5">
            <h4 class="fw-semibold mb-3">All Reviews</h4>
            <div class="row g-3">
              <% for(review of listing.reviews) { %>
                <div class="col-md-6">
                  <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-semibold mb-0">@<%= review.author.username %></h6>
                        <span class="badge text-bg-light"><%= review.rating %>/5</span>
                      </div>
                      <p class="starability-result mb-2" data-rating="<%= review.rating %>">Rated: <%= review.rating %> stars</p>
                      <p class="text-muted mb-3"><%= review.comment %></p>
                      <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                          <button class="btn btn-sm btn-outline-dark rounded-pill px-3">Delete Review</button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>
        <div class="mb-5">
          <h3 class="fw-semibold mb-1">Where you'll be 📍</h3>
          <p class="text-muted mb-3"><%= listing.location %>, <%= listing.country %></p>
          
          <div class="card border-0 rounded-4 overflow-hidden shadow-sm">
            <div id="map" style="height:400px;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/javascript/map.js"></script>

<script src="/javascript/booking.js"></script>

