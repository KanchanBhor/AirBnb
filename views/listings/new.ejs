<% layout("layouts/boilerplate") %>

    <div class="row mt-3">
        <div class="col-8 offset-2">
           <br> 
        <h3>Create new listing</h3>
    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label"> Title</label>
            <input
             name="listing[title]"
              type="text" 
              class="form-control" 
              required
              placeholder="Add a catchy title"/>
              <div class="valid-feedback">Title looks good!!</div>
        </div>
        
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
        <textarea 
        name="listing[description]" 
        placeholder="Enter description"
        class="form-control"
         required 
         ></textarea>
          <div class="invalid-feedback">Plese enter description!</div>
       </div>
        
          <div class="mb-3">
            <label for="image" class="form-label" >Upload Listing Image</label>
            <input 
            name="listing[image]" 
            required
            type="file"
            class="form-control" >
    </div>
     
    <div class="row">
    <div class="mb-3 col-md-4">
        <label for="price" class="form-label" >Price</label>
        <input name="listing[price]" placeholder="1200"  class="form-control" required>
        <div class="invalid-feedback">Plese enter a valid price!</div>
    </div>  

    <div class="mb-3 col-md-8">
        <label for="country" class="form-label" >Country</label>
        <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
        <div class="invalid-feedback">Plese enter a country name</div>
    </div>  
</div>
    <div class="mb-3">
        <label for="location" class="form-label" >Location</label>
        <input name="listing[location]" placeholder="Maharashtra" type="text" class="form-control" required>
        <div class="invalid-feedback">Plese enter a location</div>
    </div>

    <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select name="listing[category]" id="category" class="form-select" required>
            <option value="">Select a category</option>
            <option value="Mountains">🏔️ Mountains</option>
            
            <option value="Iconic Cities">🏙️ Iconic Cities</option>
            <option value="Farms">🌾 Farms</option>
            <option value="Arctic">❄️ Arctic</option>
            <option value="Beaches">🏖️ Beaches</option>
            <option value="Forests">🌲 Forests</option>
            <option value="Islands">🏝️ Islands</option>
            <option value="Camping">🏕️ Camping</option>
            <option value="Castles">🏰 Castles</option>
            <option value="Countryside">🌳 Countryside</option>
            <option value="Historical">🏛️ Historical</option>
        </select>
    </div>
        
        <button class="btn btn-dark add-btn mt-3 mb-3">Add</button>
        
    </form>
</div>
</div>