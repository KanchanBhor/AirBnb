<% layout("layouts/boilerplate") %>
<div class="container mt-4">
  <h2 class="mb-4">My Wishlist ❤️</h2>
  <% if(wishlist.length === 0) { %>
    <div class="text-center mt-5">
      <h4>Your wishlist is empty 💔</h4>
      <p class="text-muted">Start saving places you love!</p>
      <a href="/listings" class="btn btn-dark rounded-pill px-4">Explore Listings</a>
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
      <% for(let list of wishlist) { %>
        <div class="col">
          <a href="/listings/<%= list._id %>" class="listing-link">
            <div class="card h-100 border-0">
              <img src="<%= list.image.url %>" class="card-img-top rounded-4" alt="listing image" style="height:220px; object-fit:cover;">
              <div class="card-body px-1">
                <h6 class="card-title mb-1"><%= list.title %></h6>
                <p class="card-text mb-0"><b>₹<%= list.price.toLocaleString("en-IN") %></b> / night</p>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>
</div>